# Copie para .env.local. Reinicie o Vite depois de editar.
# O mock só funciona com npm run dev; produção sempre usa a API real.
VITE_USE_MOCK_API=true
VITE_MOCK_DELAY_MS=450
# success | empty | error | members-error | offline | rate-limit | expired
VITE_MOCK_SCENARIO=success

# API real: desative o mock e use o proxy local.
API_PROXY_TARGET=http://localhost:8000
# Em produção: origem da API, sem /api/v1 no final.
# VITE_API_URL=https://api.seu-clube.example
